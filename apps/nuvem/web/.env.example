# Config do app do escritório. Copie para .env.local (não versionado).
# Valores reais estão na Memória do Projeto (Notion) — NUNCA commitar segredos.
NEXT_PUBLIC_SUPABASE_URL=...
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=...
# Conta de serviço da retaguarda (sessão compartilhada p/ acesso a dados — ADR-0019).
# SÓ no servidor (sem prefixo NEXT_PUBLIC). Segredo → Notion.
ESCRITORIO_EMAIL=...
ESCRITORIO_SENHA=...
# Catalogo via API: experimental, apenas servidor, habilitacao em runtime.
API_CATALOGO_ENABLED=false
# Fornecedores e formas de pagamento via API: experimental e independente do catalogo.
API_REFERENCIAS_ENABLED=false
API_USUARIOS_ENABLED=false
API_PDV_STATUS_ENABLED=false
# Saldos, extratos, ajustes, inventario e divergencias via API.
API_ESTOQUE_ENABLED=false
API_LANCAMENTOS_ENABLED=false
API_TURNOS_ENABLED=false
API_VENDAS_ENABLED=false
API_RELATORIOS_ENABLED=false
NUVEM_API_URL=http://127.0.0.1:3002
