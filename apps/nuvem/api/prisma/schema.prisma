generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Livro {
  syncUid                  String                     @id @map("sync_uid") @db.Uuid
  codigo                   String                     @unique
  titulo                   String
  autor                    String?
  precoCentavos            BigInt                     @default(0) @map("preco_centavos")
  categoria                Int                        @default(0)
  descricao                String?
  buscaNorm                String                     @default("") @map("busca_norm")
  ativo                    Boolean                    @default(true)
  origem                   String                     @default("pdv")
  atualizadoEm             DateTime?                  @map("atualizado_em") @db.Timestamptz(6)
  excluidoEm               DateTime?                  @map("excluido_em") @db.Timestamptz(6)
  criadoPor                String?                    @map("criado_por") @db.Uuid
  sincronizadoEm           DateTime                   @default(now()) @map("sincronizado_em") @db.Timestamptz(6)
  divergencia_estoque      divergencia_estoque[]
  item_lancamento          item_lancamento[]
  item_pedido              item_pedido[]
  movimento_estoque        movimento_estoque[]
  saldo_partida_producao   saldo_partida_producao?
  transferencia_destinacao transferencia_destinacao[]

  @@index([sincronizadoEm], map: "idx_livro_sinc")
  @@map("livro")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model alocacao_venda {
  sync_uid        String      @id @db.Uuid
  pedido_uid      String      @db.Uuid
  item_uid        String      @db.Uuid
  destinacao_uid  String      @db.Uuid
  qtd             BigInt
  valor_centavos  BigInt
  origem          String      @default("pdv")
  atualizado_em   DateTime?   @db.Timestamptz(6)
  excluido_em     DateTime?   @db.Timestamptz(6)
  criado_por      String?     @db.Uuid
  sincronizado_em DateTime    @default(now()) @db.Timestamptz(6)
  destinacao      destinacao  @relation(fields: [destinacao_uid], references: [sync_uid], onDelete: NoAction, onUpdate: NoAction)
  item_pedido     item_pedido @relation(fields: [item_uid], references: [sync_uid], onDelete: NoAction, onUpdate: NoAction)
  pedido          pedido      @relation(fields: [pedido_uid], references: [sync_uid], onDelete: NoAction, onUpdate: NoAction)

  @@index([sincronizado_em], map: "idx_alocacao_venda_sinc")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model destinacao {
  sync_uid                                                                          String                     @id @db.Uuid
  nome                                                                              String
  nome_norm                                                                         String                     @unique
  de_sistema                                                                        Boolean                    @default(false)
  ativa                                                                             Boolean                    @default(true)
  ordem                                                                             Int                        @default(0)
  origem                                                                            String                     @default("pdv")
  atualizado_em                                                                     DateTime?                  @db.Timestamptz(6)
  excluido_em                                                                       DateTime?                  @db.Timestamptz(6)
  criado_por                                                                        String?                    @db.Uuid
  sincronizado_em                                                                   DateTime                   @default(now()) @db.Timestamptz(6)
  alocacao_venda                                                                    alocacao_venda[]
  transferencia_destinacao_transferencia_destinacao_de_destinacao_uidTodestinacao   transferencia_destinacao[] @relation("transferencia_destinacao_de_destinacao_uidTodestinacao")
  transferencia_destinacao_transferencia_destinacao_para_destinacao_uidTodestinacao transferencia_destinacao[] @relation("transferencia_destinacao_para_destinacao_uidTodestinacao")

  @@index([sincronizado_em], map: "idx_destinacao_sinc")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model divergencia_estoque {
  sync_uid        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pedido_uid      String?      @db.Uuid
  item_pedido_uid String?      @db.Uuid
  livro_uid       String?      @db.Uuid
  tipo            String
  descricao       String       @default("")
  saldo_antes     BigInt?
  qtd_evento      BigInt?
  status          String       @default("aberta")
  criado_em       DateTime     @default(now()) @db.Timestamptz(6)
  resolvida_em    DateTime?    @db.Timestamptz(6)
  resolvida_por   String?      @db.Uuid
  origem          String       @default("escritorio")
  atualizado_em   DateTime?    @db.Timestamptz(6)
  excluido_em     DateTime?    @db.Timestamptz(6)
  criado_por      String?      @db.Uuid
  sincronizado_em DateTime     @default(now()) @db.Timestamptz(6)
  item_pedido     item_pedido? @relation(fields: [item_pedido_uid], references: [sync_uid], onDelete: NoAction, onUpdate: NoAction)
  livro           Livro?       @relation(fields: [livro_uid], references: [syncUid], onDelete: NoAction, onUpdate: NoAction)
  pedido          pedido?      @relation(fields: [pedido_uid], references: [sync_uid], onDelete: NoAction, onUpdate: NoAction)
  usuario         usuario?     @relation(fields: [resolvida_por], references: [sync_uid], onDelete: NoAction, onUpdate: NoAction)

  @@index([status, criado_em], map: "idx_divergencia_estoque_status")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model forma_pagamento {
  sync_uid         String             @id @db.Uuid
  chave            String             @unique
