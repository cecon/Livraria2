# Development-agent memory only; Node >=22. Never used by PDV/cloud runtime.
AGENTMEMORY_ENABLED=false
AGENTMEMORY_URL=http://127.0.0.1:3131
AGENTMEMORY_SECRET=
AGENTMEMORY_PROJECT_ID=
AGENTMEMORY_TEAM_ID=
AGENTMEMORY_USER_ID=
AGENTMEMORY_AGENT_ID=
AGENTMEMORY_MODE=private
AGENTMEMORY_TIMEOUT_MS=2000
AGENTMEMORY_MAX_CONTEXT_ITEMS=10
AGENTMEMORY_MAX_CONTEXT_CHARS=8000
# An externally built image, verified against upstream deployment contract.
AGENTMEMORY_IMAGE=
AGENTMEMORY_PORT=3131
